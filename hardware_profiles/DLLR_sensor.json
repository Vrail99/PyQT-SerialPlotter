{
    "name": "DLLR Sensor Driver",
    "driver": "GenericSerialDriver",
    "baudrate": 115200,
    "timeout": 1.0,
    "terminator": "\n",
    "data_format": {
        "type": "csv",
        "separator": ",",
        "scale_factors": []
    },
    "datalines": [
        {
            "name": "Pa",
            "index": 0,
            "visible": true
        },
        {
            "name": "mbar",
            "index": 1,
            "visible": true
        },
        {
            "name": "InH2O",
            "index": 2,
            "visible": true
        },
        {
            "name": "Temperature (°C)",
            "index": 3,
            "visible": true
        }
    ]
}