{
    "name": "X_INCH_D_MV Driver",
    "driver": "GenericSerialDriver",
    "baudrate": 921600,
    "timeout": 1.0,
    "terminator": "\n",
    "commands": {
        "read_pressure": "READ_PRESSURE",
        "read_pressure_average": "READ_PRESSURE_AVG",
        "enable_continuous_mode": "ENABLE_OUTPUT 1",
        "disable_continuous_mode": "ENABLE_OUTPUT 0",
        "save_params": "SAVE_PARAMS",
        "get_params": "SYNC_PARAMS",
        "calibrate_zero": "CALIBRATE_ZERO",
        "CAL P_Slope":{
            "template": "CALIBRATE_SLOPE {value}",
            "input": "float",
            "placeholder": "P_FS (mbar)",
            "default": "10.0"
        },
        "Averages": {
            "template": "SET_NR_AVERAGES {value}",
            "input": "int",
            "placeholder": "Averages",
            "default": "50"
        },
        "Filter":{
            "template": "SET_FILTER {value}",
            "input": "int",
            "placeholder": "Filter",
            "default": "0"
        }
    },
    "input_data_format": {
        "separator": ",",
        "unit": "Bar",
        "scale_factor": 0.001
    },
    "output_data_format": {
        "type": "csv",
        "separator": ",",
        "scale_factors": []
    },
    "datalines": [
        {
            "name": "Differential Pressure",
            "index": 0,
            "visible": true
        },
        {
            "name": "Line 2",
            "index": 1,
            "visible": true
        },
        {
            "name": "Line 3",
            "index": 2,
            "visible": true
        },
        {
            "name": "Line 4",
            "index": 3,
            "visible": true
        },
        {
            "name": "Line 5",
            "index": 4,
            "visible": true
        },
        {
            "name": "Line 6",
            "index": 5,
            "visible": true
        }
    ]
}